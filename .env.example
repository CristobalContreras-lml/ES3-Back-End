# Copia este archivo como .env y completa los valores.
# El .env NO se sube al repositorio (esta en .gitignore).

# --- Django ---
# Genera una clave nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos ---
# Por defecto SQLite, que no necesita usuario ni contrasena.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Si algun dia se cambia a PostgreSQL, se descomenta esto y se completa.
# El codigo no cambia: solo este archivo.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=vencimientos
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Usuarios de prueba (los crea: python manage.py crear_roles) ---
PASS_ADMIN=
PASS_NORMAL=
PASS_VIEWER=
